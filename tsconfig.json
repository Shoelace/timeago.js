{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ESNext"],
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*","__tests__"],
  "exclude": ["node_modules", "dist"]
}
